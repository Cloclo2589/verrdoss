<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Verrdoss.App</RootNamespace>
    <AssemblyName>Verrdoss</AssemblyName>
    <Version>1.0.5</Version>
    <Product>VerrDoss</Product>
    <Company>VerrDoss</Company>
    <ApplicationIcon>Assets\verrdoss.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Include="System.IO" />
    <Using Include="System.Windows" />
    <Using Include="System.Windows.Input" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\verrdoss.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Verrdoss.Core\Verrdoss.Core.csproj" />
    <ProjectReference Include="..\Verrdoss.Context\Verrdoss.Context.csproj" />
  </ItemGroup>
  <Target Name="CopyComHost" AfterTargets="Build">
    <ItemGroup>
      <ComHostFile Include="$(MSBuildThisFileDirectory)..\Verrdoss.Context\bin\$(Configuration)\net8.0-windows\Verrdoss.Context.comhost.dll" />
      <ComHostFile Include="$(MSBuildThisFileDirectory)..\Verrdoss.Context\bin\$(Configuration)\net8.0-windows\Verrdoss.Context.runtimeconfig.json" />
      <ComHostFile Include="$(MSBuildThisFileDirectory)..\Verrdoss.Context\bin\$(Configuration)\net8.0-windows\Verrdoss.Context.deps.json" />
    </ItemGroup>
    <Copy SourceFiles="@(ComHostFile)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="Exists('%(ComHostFile.Identity)')" />
  </Target>
  <Target Name="IncludeComHostInPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <_ComHostPublish Include="$(MSBuildThisFileDirectory)..\Verrdoss.Context\bin\$(Configuration)\net8.0-windows\Verrdoss.Context.runtimeconfig.json" />
      <_ComHostPublish Include="$(MSBuildThisFileDirectory)..\Verrdoss.Context\bin\$(Configuration)\net8.0-windows\Verrdoss.Context.deps.json" />
    </ItemGroup>
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_ComHostPublish)">
        <RelativePath>%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
