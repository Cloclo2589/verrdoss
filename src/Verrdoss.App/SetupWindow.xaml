<Window x:Class="Verrdoss.App.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Créer le mot de passe de secours" Height="Auto" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Border Style="{StaticResource Card}" Margin="16">
        <StackPanel>
            <TextBlock Style="{StaticResource BodyText}"
                       Text="Choisissez un mot de passe de secours d'au moins 8 caractères. Il peut ouvrir un dossier si son mot de passe est oublié. Il est protégé sur ce compte Windows, jamais enregistré en clair."/>
            <TextBlock Text="Mot de passe de secours" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
            <PasswordBox x:Name="PasswordInput"/>
            <TextBlock Text="Confirmation" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
            <PasswordBox x:Name="ConfirmInput"/>
            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Quitter" Style="{StaticResource SecondaryButton}" IsCancel="True"/>
                <Button Grid.Column="2" Content="Créer" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnCreate"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
