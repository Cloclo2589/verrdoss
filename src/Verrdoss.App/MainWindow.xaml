<Window x:Class="Verrdoss.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VerrDoss" Height="640" Width="980" MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="VerrDoss" Style="{StaticResource TitleText}"/>
            <TextBlock Text="Dossiers chiffrés sur cet ordinateur" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="272"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="8,4,8,8">
                <ListView x:Name="VaultList">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                            <EventSetter Event="MouseDoubleClick" Handler="OnOpenItem"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Dossier" DisplayMemberBinding="{Binding Name}" Width="160"/>
                            <GridViewColumn Header="Emplacement" DisplayMemberBinding="{Binding Location}" Width="340"/>
                            <GridViewColumn Header="État" DisplayMemberBinding="{Binding State}" Width="180"/>
                            <GridViewColumn Header="Mot de passe propre" DisplayMemberBinding="{Binding OwnPassword}" Width="150"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <Button Content="Ajouter un dossier" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" Click="OnAdd"/>
                    <Button Content="Verrouiller" Margin="0,0,0,8" Click="OnLock"/>
                    <Button Content="Déverrouiller" Margin="0,0,0,8" Click="OnUnlock"/>
                    <Button Content="Mot de passe du dossier" Margin="0,0,0,8" Click="OnFolderPassword"/>
                    <Button Content="Retirer la protection" Style="{StaticResource DangerButton}" Margin="0,0,0,8" Click="OnRemove"/>
                    <Button Content="Paramètres" Margin="0,0,0,8" Click="OnSettings"/>
                    <Button Content="Quitter" Click="OnQuit"/>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" x:Name="LimitsText" Style="{StaticResource CaptionText}" Margin="0,16,0,0"/>
    </Grid>
</Window>
