<Window x:Class="Verrdoss.App.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VerrDoss" Height="Auto" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="False">
    <Border Style="{StaticResource Card}" Margin="16">
        <StackPanel>
            <TextBlock x:Name="PromptText" Style="{StaticResource BodyText}"/>
            <PasswordBox x:Name="PasswordInput" Margin="0,16,0,0"/>
            <TextBlock x:Name="ConfirmLabel" Text="Confirmation" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" Visibility="Collapsed"/>
            <PasswordBox x:Name="ConfirmInput" Visibility="Collapsed"/>
            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Annuler" Style="{StaticResource SecondaryButton}" IsCancel="True" Click="OnCancel"/>
                <Button Grid.Column="2" Content="Valider" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnOk"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
